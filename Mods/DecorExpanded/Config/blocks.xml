        <property name="ItemTypeIcon" value="all_blocks"/>
        <property name="SelectAlternates" value="true"/>
        <property name="PlaceAltBlockValue" value="storeSignNeon01"/>
        <property name="EconomicValue" value="90"/>
    </block>

    <!-- Pack déco tissus / tentes / bannières -->
    <block name="decorFabricVariantHelper">
        <property name="Extends" value="air"/>
        <property name="CustomIcon" value="tentBiohazardCapLeftRed"/>
        <property name="CreativeMode" value="Player"/>
        <property name="DescriptionKey" value="decorFabricVariantHelperDesc"/>
        <property name="ItemTypeIcon" value="all_blocks"/>
        <property name="SelectAlternates" value="true"/>
        <property name="PlaceAltBlockValue" value="tentBiohazardCapLeftRed"/>
        <property name="EconomicValue" value="90"/>
