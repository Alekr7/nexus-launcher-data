        <property name="ItemTypeIcon" value="all_blocks"/>
        <property name="SelectAlternates" value="true"/>
        <property name="PlaceAltBlockValue" value="couch01"/>
        <property name="EconomicValue" value="80"/>
    </block>

    <!-- Pack déco bureau / office -->
    <block name="decorOfficeVariantHelper">
        <property name="Extends" value="air"/>
        <property name="CustomIcon" value="officeChair01"/>
        <property name="CreativeMode" value="Player"/>
        <property name="DescriptionKey" value="decorOfficeVariantHelperDesc"/>
        <property name="ItemTypeIcon" value="all_blocks"/>
        <property name="SelectAlternates" value="true"/>
        <property name="PlaceAltBlockValue" value="officeChair01"/>
        <property name="EconomicValue" value="80"/>
    </block>

    <!-- Pack déco extérieur / jardin -->
    <block name="decorOutdoorVariantHelper">
        <property name="Extends" value="air"/>
        <property name="CustomIcon" value="parkBenchA"/>
        <property name="CreativeMode" value="Player"/>
        <property name="DescriptionKey" value="decorOutdoorVariantHelperDesc"/>
        <property name="ItemTypeIcon" value="all_blocks"/>
        <property name="SelectAlternates" value="true"/>
        <property name="PlaceAltBlockValue" value="parkBenchA"/>
        <property name="EconomicValue" value="70"/>
    </block>

    <!-- Pack déco panneaux / enseignes -->
    <block name="decorSignageVariantHelper">
        <property name="Extends" value="air"/>
        <property name="CustomIcon" value="storeSignNeon01"/>
        <property name="CreativeMode" value="Player"/>
