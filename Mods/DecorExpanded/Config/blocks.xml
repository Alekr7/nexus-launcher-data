<append xpath="/blocks">

    <!-- Pack déco en bois -->
    <block name="decorWoodVariantHelper">
        <property name="Extends" value="air"/> <!-- au lieu de wineBarrel -->
        <property name="CustomIcon" value="wineBarrel"/>
        <property name="CreativeMode" value="Player"/>
        <property name="DescriptionKey" value="decorWoodVariantHelperDesc"/>
        <property name="ItemTypeIcon" value="all_blocks"/>
        <property name="SelectAlternates" value="true"/>
        <property name="PlaceAltBlockValue"
                  value="wineBarrel,barStool,parkBenchA,parkBenchB,decoPoolTable"/>
        <property name="EconomicValue" value="60"/>
    </block>

    <!-- Pack déco métal / industriel -->
    <block name="decorMetalVariantHelper">
        <property name="Extends" value="air"/> <!-- au lieu de trashCan01 -->
        <property name="CustomIcon" value="trashCan01"/>
        <property name="CreativeMode" value="Player"/>
        <property name="DescriptionKey" value="decorMetalVariantHelperDesc"/>
        <property name="ItemTypeIcon" value="all_blocks"/>
        <property name="SelectAlternates" value="true"/>
        <property name="PlaceAltBlockValue" value="trashCan01"/>
        <property name="EconomicValue" value="70"/>
    </block>

    <!-- Pack déco maison / intérieur -->
    <block name="decorHomeVariantHelper">
        <property name="Extends" value="air"/>
        <property name="CustomIcon" value="couch01"/>
        <property name="CreativeMode" value="Player"/>
